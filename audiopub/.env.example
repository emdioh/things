# Copy to .env (in the folder you run audiopub from) or to ~/.config/audiopub/.env
# and fill in the keys for the providers you use. Variables exported in your
# shell take precedence over this file.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# Voices for --tts openai (e.g. a self-hosted speech server with --tts-base-url) and --tts openrouter.
# Format: id:gender[:locale], gender male/female, locale like it-IT. Replaces the built-in voice list.
# AUDIOPUB_TTS_VOICES=af_bella:female,am_adam:male:en-US
